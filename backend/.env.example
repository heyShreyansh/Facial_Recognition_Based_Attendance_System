# MongoDB connection (already present in your .env)
MONGO_URI=mongodb+srv://<user>:<pass>@cluster0.mongodb.net/AttendanceSystemDB

# SMTP settings: uncomment and fill to enable real email sending
#SMTP_HOST=smtp.sendgrid.net
#SMTP_PORT=587
#SMTP_USER=apikey
#SMTP_PASS=SG.xxxxxx
#EMAIL_FROM=no-reply@yourdomain.com

# Frontend base URL used in reset links
#FRONTEND_BASE_URL=http://localhost:3000
